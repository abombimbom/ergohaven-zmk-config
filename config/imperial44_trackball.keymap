#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>
#include <scroll-snap.dtsi>
#include "input/processors/sensor_rotation.dtsi"

&mt {
    quick-tap-ms = <250>;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <170>;
    quick-tap-ms = <210>;
    require-prior-idle-ms = <120>;
};

/ {
    behaviors {
        // Trackball button 2: tap = MB3, hold = scroll layer, tap+hold = Ctrl+Alt+Shift (best-effort)
        td_left_tap: td_left_tap {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LEFT_TAP";
            #binding-cells = <0>;
            tapping-term-ms = <130>;
            bindings = <&mkp MB3>, <&kp LS(LA(LCTRL))>;
        };

        lt_td_left: lt_td_left {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_TD_LEFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <90>;
            quick-tap-ms = <90>;
            bindings = <&mo>, <&td_left_tap>;
        };

        // Trackball button 3: tap = toggle sniper layer, hold = held MB3
        mmb_sniper: mmb_sniper {
            compatible = "zmk,behavior-hold-tap";
            label = "MMB_SNIPER";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mkp>, <&tog>;
        };

        adj1: adj1 {
            compatible = "zmk,behavior-tap-dance";
            label = "ADJ1";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&bt BT_CLR>;
        };

        adj2: adj2 {
            compatible = "zmk,behavior-tap-dance";
            label = "ADJ2";
            #binding-cells = <0>;
            bindings = <&bt BT_NXT>, <&bt BT_CLR_ALL>;
        };
    };

    combos {
        compatible = "zmk,combos";

        exclm {
            bindings = <&kp EXCL>;
            key-positions = <3 15>;
            layers = <1 0>;
        };

        dash {
            bindings = <&kp MINUS>;
            key-positions = <4 16>;
            layers = <0 1>;
        };

        en_colon {
            bindings = <&kp COLON>;
            key-positions = <5 17>;
            layers = <0>;
        };

        ru_colon {
            bindings = <&kp RU_COLON>;
            key-positions = <5 17>;
            layers = <1>;
        };

        en_semic {
            bindings = <&kp SEMICOLON>;
            key-positions = <6 18>;
            layers = <0>;
        };

        ru_semi {
            bindings = <&kp RU_SEMICOLON>;
            key-positions = <6 18>;
            layers = <1>;
        };

        undersc {
            bindings = <&kp UNDER>;
            key-positions = <7 19>;
            layers = <1 0>;
        };

        en_quest {
            bindings = <&kp QUESTION>;
            key-positions = <8 20>;
            layers = <0>;
        };

        ru_quest {
            bindings = <&kp RU_QUESTION>;
            key-positions = <8 20>;
            layers = <1>;
        };

        en_pipe {
            bindings = <&kp PIPE>;
            key-positions = <6 7>;
            layers = <4>;
        };

        ru_pipe {
            bindings = <&en PIPE>;
            key-positions = <6 7>;
            layers = <5>;
        };

        shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <12 0>;
            layers = <0 1>;
        };

        ctrl {
            bindings = <&kp RCTRL>;
            key-positions = <12 24>;
            layers = <0 1>;
        };

        gui {
            bindings = <&kp LEFT_GUI>;
            key-positions = <11 23>;
            layers = <0 1>;
        };

        ru_coma {
            bindings = <&kp RU_COMMA>;
            key-positions = <4 3>;
            layers = <1>;
        };

        ru_ha {
            bindings = <&kp RU_CYRILLIC_HA>;
            key-positions = <7 8>;
            layers = <1>;
        };

        ru_hard {
            bindings = <&kp RU_CYRILLIC_HARD_SIGN>;
            key-positions = <8 9>;
            layers = <1>;
        };

        ru_iye {
            bindings = <&kp RU_CYRILLIC_E>;
            key-positions = <21 22>;
            layers = <1>;
        };

        en_comma {
            bindings = <&kp COMMA>;
            key-positions = <4 3>;
            layers = <0>;
        };

        // Trackball buttons 45 (mmb_sniper) + 47 (mkp MB2) -> Ctrl
        combo_ctrl {
            timeout-ms = <50>;
            key-positions = <45 47>;
            bindings = <&kp LCTRL>;
            layers = <0>;
        };
    };

    macros {
        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N2))>;
            label = "TO_RU";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N1))>;
            label = "TO_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &to_en>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &to_ru>;
            label = "LAYER_RU";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&to_en>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to_ru>;

            label = "EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        ctrl_c_ctrl_r: ctrl_c_ctrl_r {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(C) &kp LC(R)>;
            label = "CTRL_C_CTRL_R";
            wait-ms = <2>;
        };

        select_row: select_row {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp HOME &kp LS(END)>;
            label = "SELECT_ROW";
        };

        copy_word: copy_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LEFT_ARROW) &kp LC(RIGHT_ARROW) &kp LC(C)>;
            label = "COPY_WORD";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
&kp ESC       &kp Q           &kp W           &kp E             &kp R        &kp T                                     &kp Y            &kp U        &kp I              &kp O            &kp P     &lt 9 LA(SPACE)
&kp LC(Z)     &mt LEFT_GUI A  &mt LEFT_ALT S  &mt LEFT_SHIFT D  &mt LCTRL F  &kp G                                     &kp H            &mt RCTRL J  &mt RIGHT_SHIFT K  &mt RIGHT_ALT L  &kp SEMI  &caps_word
&lt 8 DELETE  &kp Z           &kp X           &kp C             &kp V        &kp B        &kp K_MUTE    &kp LG(SPACE)  &kp N            &kp M        &kp COMMA          &kp DOT          &kp SQT   &lt 8 ENTER
                                                                &lt 3 DOT    &lt 2 SPACE  &lt 6 TAB     &lt 2 ESC      &lt 4 BACKSPACE  &lt 7 GRAVE

&mkp MB1           &lt_td_left 10 0
&mmb_sniper MB3 11 &mkp MB2
&adj1              &adj2
            >;

            display-name = "Base";
            sensor-bindings =
                <&inc_dec_kp K_SCROLL_DOWN K_SCROLL_UP>,
                <&inc_dec_kp LC(PLUS) LC(MINUS)>;
        };

        ru {
            display-name = "Ru";
            bindings = <
&trans  &kp RU_CYRILLIC_SHORT_I      &kp RU_CYRILLIC_TSE            &kp RU_CYRILLIC_U              &kp RU_CYRILLIC_KA       &kp RU_CYRILLIC_IE                    &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE        &kp RU_CYRILLIC_SHA            &kp RU_CYRILLIC_SHCHA        &kp RU_CYRILLIC_ZE   &trans
&trans  &mt LEFT_GUI RU_CYRILLIC_EF  &mt LEFT_ALT RU_CYRILLIC_YERU  &mt LEFT_SHIFT RU_CYRILLIC_VE  &mt LCTRL RU_CYRILLIC_A  &kp RU_CYRILLIC_PE                    &kp RU_CYRILLIC_ER  &mt LCTRL RU_CYRILLIC_O    &mt LEFT_SHIFT RU_CYRILLIC_EL  &mt LEFT_ALT RU_CYRILLIC_DE  &kp RU_CYRILLIC_ZHE  &trans
&trans  &kp RU_CYRILLIC_YA           &kp RU_CYRILLIC_CHE            &kp RU_CYRILLIC_ES             &kp RU_CYRILLIC_EM       &kp RU_CYRILLIC_I   &trans    &trans  &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE             &kp RU_CYRILLIC_YU           &trans               &trans
                                                                                                   &lt 3 RU_DOT             &trans              &trans    &trans  &lt 5 BACKSPACE     &lt 7 GRAVE

&trans  &trans
&trans  &trans
&trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&inc_dec_kp LC(PLUS) LC(MINUS)>;
        };

        nav {
            bindings = <
&kp LC(LS(KP_SLASH))   &kp LC(HOME)  &kp HOME       &kp END             &kp LC(END)  &kp LC(R)                                     &ctrl_c_ctrl_r         &kp LC(W)                &kp LA(DOWN)               &kp LA(UP)       &none            &none
&kp LC(LS(KP_DIVIDE))  &none         &mt LEFT HOME  &mt LEFT_SHIFT END  &kp LCTRL    &kp LC(RET)                                   &copy_word             &mt LCTRL LEFT_ARROW     &mt LEFT_SHIFT DOWN_ARROW  &mt LEFT_ALT UP  &kp RIGHT_ARROW  &none
&kp LC(KP_DIVIDE)      &kp LC(A)     &kp LC(X)      &kp LC(C)           &kp LC(V)    &kp LC(B)    &none    &none                   &select_row            &kp LC(D)                &kp LA(LS(DOWN_ARROW))     &kp LS(LA(UP))   &none            &none
                                                                        &none        &none        &none    &kp LC(LA(LEFT_ARROW))  &kp LC(LS(BACKSPACE))  &kp LC(LA(RIGHT_ARROW))

&trans  &trans
&trans  &trans
&trans  &trans
            >;

            display-name = "Nav";
        };

        nav_2 {
            display-name = "Nav_2";
            bindings = <
&kp LC(LS(KP_SLASH))   &kp LC(LS(HOME))        &kp LS(HOME)  &kp LS(END)    &kp LC(LS(END))          &trans                    &ctrl_c_ctrl_r  &kp LC(W)             &kp LA(DOWN)               &kp LA(UP)       &trans           &trans
&kp LC(LS(KP_DIVIDE))  &kp LS(LC(LEFT_ARROW))  &kp LS(HOME)  &kp LS(END)    &kp LS(LC(RIGHT_ARROW))  &trans                    &select_row     &mt LCTRL LEFT_ARROW  &mt LEFT_SHIFT DOWN_ARROW  &mt LEFT_ALT UP  &kp RIGHT_ARROW  &trans
&kp LC(KP_DIVIDE)      &kp ENTER               &trans        &kp BACKSPACE  &kp LC(ENTER)            &trans  &trans    &trans  &copy_word      &kp LC(D)             &kp LA(LS(DOWN_ARROW))     &kp LS(LA(UP))   &trans           &trans
                                                                            &trans                   &trans  &trans    &trans  &trans          &trans

&trans  &trans
&trans  &trans
&trans  &trans
            >;
        };

        sym_en {
            display-name = "Symbols";
            bindings = <
&trans          &kp AT           &kp AMPERSAND        &none        &kp LEFT_BRACKET  &kp RIGHT_BRACKET                    &kp NUBS   &kp FSLH   &kp MINUS  &kp EXCL       &kp CARET         &kp CLCK
&trans          &kp GRAVE        &mt LEFT_ALT DOLLAR  &kp PRCNT    &none             &kp SQT                              &layer_ru  &kp ASTRK  &kp PLUS   &kp EQUAL      &kp TILDE         &kp INS
&kp LEFT_BRACE  &kp RIGHT_BRACE  &kp RU_NUMERO        &kp AT_SIGN  &kp HASH          &kp DQT            &trans    &trans  &layer_en  &kp LPAR   &kp RPAR   &kp LESS_THAN  &kp GREATER_THAN  &trans
                                                                   &trans            &mo 9              &trans    &trans  &trans     &trans

&trans  &trans
&trans  &trans
&trans  &trans
            >;
        };

        sym_ru {
            display-name = "Symbols";
            bindings = <
&trans          &en AT           &en AMPERSAND  &none        &en LEFT_BRACKET  &en RIGHT_BRACKET                       &kp NUBS   &kp RU_SLASH  &kp MINUS  &kp EXCL       &en CARET         &kp CLCK
&trans          &en GRAVE        &en DOLLAR     &en PRCNT    &none             &en SQT                                 &layer_ru  &kp ASTRK     &kp PLUS   &kp EQUAL      &en TILDE         &kp INS
&en LEFT_BRACE  &en RIGHT_BRACE  &kp RU_NUMERO  &en AT_SIGN  &en HASH          &kp RU_DOUBLE_QUOTES  &trans    &trans  &layer_en  &kp LPAR      &kp RPAR   &en LESS_THAN  &en GREATER_THAN  &trans
                                                             &trans            &mo 9                 &trans    &trans  &trans     &trans

&trans  &trans
&trans  &trans
&trans  &trans
            >;
        };

        shortcut_en {
            bindings = <
&trans  &kp LC(Q)  &kp LC(W)  &kp LC(E)             &kp LC(R)        &kp LC(T)                     &kp LS(LG(S))  &kp LG(LC(T))  &kp LC(LS(LG(T)))  &kp LC(O)               &trans                  &trans
&trans  &kp LC(D)  &kp LC(S)  &mt LEFT_SHIFT LG(D)  &mt LCTRL LC(F)  &kp LS(F6)                    &kp LC(H)      &kp LCTRL      &kp LEFT_SHIFT     &mt LEFT_ALT LC(LS(L))  &mt LEFT_GUI LA(LC(L))  &trans
&trans  &trans     &trans     &trans                &kp LC(B)        &kp LG(V)   &trans    &trans  &kp E          &trans         &trans             &trans                  &kp F6                  &trans
                                                    &trans           &trans      &trans    &trans  &trans         &trans

&trans  &trans
&trans  &trans
&trans  &trans
            >;

            label = "shortcut_en";
        };

        num {
            bindings = <
&trans  &trans  &kp F7           &kp F8             &kp F9        &kp F10                    &trans  &kp N7              &kp N8                   &kp N9           &kp N0  &trans
&trans  &trans  &mt LEFT_ALT F4  &mt LEFT_SHIFT F5  &mt LCTRL F8  &kp F11                    &trans  &mt LCTRL NUMBER_4  &mt LEFT_SHIFT NUMBER_5  &mt LEFT_ALT N6  &trans  &trans
&trans  &trans  &kp F1           &kp F2             &kp F3        &kp F12  &trans    &trans  &kp N0  &kp N1              &kp N2                   &kp N3           &trans  &trans
                                                    &trans        &trans   &trans    &trans  &trans  &trans

&trans  &trans
&trans  &trans
&trans  &trans
            >;
        };

        macro {
            display-name = "macro";
            bindings = <
&trans  &trans  &kp HOME      &kp UP    &kp END        &kp INS                    &kp PG_UP        &kp N7  &kp N8  &kp N9  &trans  &trans
&trans  &trans  &kp LEFT      &kp DOWN  &kp RIGHT      &kp RET                    &kp PG_DN        &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &trans  &kp LC(LEFT)  &kp CAPS  &kp LC(RIGHT)  &kp DEL  &trans    &trans  &kp PRINTSCREEN  &kp N1  &kp N2  &kp N3  &trans  &trans
                                        &trans         &trans   &trans    &trans  &mo 0            &trans

&trans  &trans
&trans  &trans
&trans  &trans
            >;
        };

        adj {
            bindings = <
&bootloader     &out OUT_USB  &trans  &trans  &trans  &bt BT_CLR_ALL                    &none         &trans        &trans        &trans        &trans  &bt BT_CLR_ALL
&trans          &trans        &trans  &trans  &trans  &trans                            &none         &bt BT_SEL 4  &trans        &trans        &trans  &trans
&bt BT_CLR_ALL  &out OUT_BLE  &trans  &trans  &trans  &trans          &trans    &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans  &bt BT_CLR
                                              &trans  &trans          &trans    &trans  &trans        &trans

&trans  &trans
&trans  &trans
&trans  &trans
            >;
        };

        scroll {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                &trans  &trans  &trans  &trans  &trans  &trans

&trans  &trans
&trans  &trans
&trans  &trans
            >;
        };

        sniper {
            display-name = "Sniper";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                &trans  &trans  &trans  &trans  &trans  &trans

&trans  &trans
&trans  &trans
&trans  &trans
            >;
        };
    };

    input_processors {
        sensor_rotation: sensor_rotation {
            compatible = "zmk,input-processor-sensor-rotation";
            status = "okay";
            #input-processor-cells = <0>;
            rotation-angle = <5>;
        };
    };
};

&trackball { cpi = <400>; };

&trackball_listener {
    input-processors = <&sensor_rotation>;

    scroller {
        layers = <10>;
        input-processors =
            <&sensor_rotation>,
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_xy_scaler 1 16>,
            <&zip_xy_to_scroll_mapper &zip_scroll_snap>;
    };

    sniper {
        layers = <11>;
        input-processors = <&sensor_rotation>, <&zip_xy_scaler 1 4>;
    };
};
