#include "keys_ru.h"
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <scroll-snap.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "input/processors/sensor_rotation.dtsi"

/ {
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <2>;
        rows = <3>;
        map = <
        RC(0,3) RC(0,2)
        RC(0,0) RC(0,1)
        RC(0,5) RC(0,4)
        >;
    };

    behaviors {
        // Кнопка 2: тап = MB3, холд = scroll layer, тап+холд = Ctrl+Alt+Shift (best-effort, не всегда стабильно)
        td_left_tap: td_left_tap {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LEFT_TAP";
            #binding-cells = <0>;
            tapping-term-ms = <130>;
            bindings = <&mkp MB3>, <&kp LS(LA(LCTRL))>;
        };

        lt_td_left: lt_td_left {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_TD_LEFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <90>;
            quick-tap-ms = <90>;
            bindings = <&mo>, <&td_left_tap>;
        };

        // Кнопка 3: тап = tog sniper layer, холд = зажатая MB3
        mmb_sniper: mmb_sniper {
            compatible = "zmk,behavior-hold-tap";
            label = "MMB_SNIPER";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mkp>, <&tog>;
        };

        adj1: adj1 {
            compatible = "zmk,behavior-tap-dance";
            label = "ADJ1";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&bt BT_CLR>;
        };

        adj2: adj2 {
            compatible = "zmk,behavior-tap-dance";
            label = "ADJ2";
            #binding-cells = <0>;
            bindings = <&bt BT_NXT>, <&bt BT_CLR_ALL>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_ctrl {
            timeout-ms = <50>;
            key-positions = <1 3>;
            bindings = <&kp LCTRL>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&mkp MB1           &lt_td_left 1 0
&mmb_sniper MB3 2  &mkp MB2
&adj1              &adj2
            >;

            display-name = "Base";
        };

        scroll {
            bindings = <
&trans  &trans
&trans  &trans
&trans  &trans
            >;

            display-name = "Scroll";
        };

        sniper {
            bindings = <
&trans  &trans
&trans  &trans
&trans  &trans
            >;

            display-name = "Sniper";
        };
    };

    input_processors {
        sensor_rotation: sensor_rotation {
            compatible = "zmk,input-processor-sensor-rotation";
            status = "okay";
            #input-processor-cells = <0>;
            rotation-angle = <5>;
        };
    };
};

&trackball { cpi = <400>; };

&trackball_listener {
    input-processors = <&sensor_rotation>;

    scroller {
        layers = <1>;
        input-processors =
            <&sensor_rotation>,
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_xy_scaler 1 16>,
            <&zip_xy_to_scroll_mapper &zip_scroll_snap>;
    };

    sniper {
        layers = <2>;
        input-processors = <&sensor_rotation>, <&zip_xy_scaler 1 4>;
    };
};
